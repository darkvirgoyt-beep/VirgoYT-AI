# URL of the backend server (used by the web client)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Google Sign-In OAuth 2.0 Client ID (Web application type) — enables the
# "Continue with Google" button on the Welcome screen. Server must also have
# GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET set, plus a matching redirect URI.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
