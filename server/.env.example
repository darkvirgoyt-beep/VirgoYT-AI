# VirgoYT Cloud AI server configuration

# Google Gemini API key (for live AI responses)
GEMINI_API_KEY=

# Server port
PORT=8080

# Origin of the web client (for CORS)
CLIENT_ORIGIN=http://localhost:3000

# Secret for signing JWT tokens (change in production!)
JWT_SECRET=virgoyt-dev-secret-change-me

# Where sandbox workspaces are stored
WORKSPACE_ROOT=./workspaces

# Database path
DB_PATH=./data/virgoyt.db
