# ===== VirgoYT Cloud AI server configuration =====

# ----- Google Gemini (free tier available) -----
GEMINI_API_KEY=

# ----- OpenAI / ChatGPT -----
OPENAI_API_KEY=

# ----- Anthropic Claude -----
ANTHROPIC_API_KEY=

# ----- Groq (FREE tier — no cost) -----
GROQ_API_KEY=

# ----- OpenRouter (200+ models) -----
OPENROUTER_API_KEY=

# ----- DeepSeek via Kie.ai -----
KIE_API_KEY=

# ----- NVIDIA NIM -----
NVIDIA_API_KEY=

# ----- Mistral AI -----
MISTRAL_API_KEY=

# ----- BazaarLink universal gateway -----
BAZAARLINK_API_KEY=

# ----- Hugging Face (FREE inference) -----
HF_API_KEY=

# ----- Custom OpenAI-compatible API (any provider) -----
# Point the gateway at your own endpoint (OpenAI, Together, Ollama via ngrok, any /v1 provider).
CUSTOM_API_KEY=
CUSTOM_API_BASE_URL=https://api.openai.com/v1
CUSTOM_API_MODEL=gpt-4o

# ----- Server settings -----
PORT=8080
CLIENT_ORIGIN=http://localhost:3000

# ----- Google Apps Script backend (OPTIONAL, takes priority when set) -----
# Set this to your deployed Google Apps Script Web App URL
# (Deploy > New deployment > Web app > "Execute as Me" + "Anyone").
# When present, /api/ai/chat forwards prompts to your script for real AI.
GOOGLE_SCRIPT_URL=
JWT_SECRET=change-me-in-production
WORKSPACE_ROOT=./workspaces
DB_PATH=./data/virgoyt.json
MEMORY_PATH=./data/memory.json
