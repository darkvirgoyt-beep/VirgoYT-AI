# ===== VirgoYT Cloud AI server configuration =====

# ----- Google Gemini (free tier available) -----
GEMINI_API_KEY=

# ----- OpenAI / ChatGPT -----
OPENAI_API_KEY=

# ----- Anthropic Claude -----
ANTHROPIC_API_KEY=

# ----- Groq (FREE tier — no cost) -----
GROQ_API_KEY=

# ----- OpenRouter (200+ models) -----
OPENROUTER_API_KEY=

# ----- DeepSeek via Kie.ai -----
KIE_API_KEY=

# ----- NVIDIA NIM -----
NVIDIA_API_KEY=

# ----- Mistral AI -----
MISTRAL_API_KEY=

# ----- BazaarLink universal gateway -----
BAZAARLINK_API_KEY=

# ----- Hugging Face (FREE inference) -----
HF_API_KEY=

# ----- Server settings -----
PORT=8080
CLIENT_ORIGIN=http://localhost:3000
JWT_SECRET=change-me-in-production
WORKSPACE_ROOT=./workspaces
DB_PATH=./data/virgoyt.json
